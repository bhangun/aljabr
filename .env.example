# ==============================================================================
# Aljabr Vibe Coder Environment Configuration
# Copy this file to .env or .env.local to customize your development setup.
# ==============================================================================

# Runtime Mode: 'development' (uses local source checkouts) or 'production' (uses release binaries)
ALJABR_MODE=development

# Workspace & Repository Paths (leave blank to auto-detect from platform root)
# WAYANG_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Wayang/wayang-platform
# GOLLEK_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Wayang/wayang-platform/Families/gollek
# ALJABR_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Wayang/wayang-platform/Projects/Wayang-Agents/Aljabr

# Gollek Local Inference Configuration
GGUF_CONTEXT_SIZE=8192
GOLLEK_PORT=8080
GOLLEK_GRPC_PORT=9131

# Aljabr Agent Backend Ports
ALJABR_HTTP_PORT=8085
ALJABR_GRPC_PORT=9000

# Java Runtime (if not in standard PATH or /usr/libexec/java_home)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/openjdk-21.jdk/Contents/Home
