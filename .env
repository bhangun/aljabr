# Aljabr configuration

# Runtime Mode: 'development' or 'production'
ALJABR_MODE=development

# Workspace & Repository Paths (leave commented out to auto-detect):
GOLLEK_SOURCE_PATH=~/Workspace/workkayys/Products/Wayang/wayang-platform/Families/gollek
WAYANG_SOURCE_PATH=~/Workspace/workkayys/Products/Wayang/wayang-platform/Families/wayang
ALJABR_SOURCE_PATH=~/Workspace/workkayys/Products/Wayang/wayang-platform/Projects/Wayang-Agents/Aljabr/Community/Backend
GGUF_CONTEXT_SIZE=8192


# Gollek Local Inference Configuration
GGUF_CONTEXT_SIZE=8192
GOLLEK_PORT=8080
